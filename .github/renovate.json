{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "packageRules": [
    {
      "matchManagers": ["docker-compose"],
      "groupName": "Docker Compose images",
      "automerge": false
    },
    {
      "matchManagers": ["terraform"],
      "groupName": "OpenTofu & Terraform providers",
      "automerge": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions dependencies",
      "automerge": true
    },
    {
      "matchCategories": ["python"],
      "groupName": "Python dependencies",
      "automerge": false
    },
    {
      "matchPackageNames": ["python", "actions/python-versions"],
      "allowedVersions": "<3.14",
      "description": "Restricts runner Python to stable versions (<3.14) due to Ansible dataclasses._is_type incompatibility. Tracked in Issue #13."
    }
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10,
  "schedule": ["before 6am on monday"],
  "timezone": "America/Argentina/Buenos_Aires"
}
